# Public, build-time config. Both values are designed to ship in the page source:
# the publishable key identifies the project, and row-level security is what
# actually protects the data. Never put a service_role / secret key here.
VITE_SUPABASE_URL=https://vrubxrwsrobibcefgxmp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Yc7YyFuILCyJGXRjMztxCw_Ghbr3T7E

# AdSense. The client id is public by design and already baked into the build.
# Ad unit ids go here once created in the AdSense dashboard; without them the
# explicit placements render nothing and only auto ads run.
