# Copy to `.env.local` and fill in. All are optional — the site runs without them,
# but leaderboards go local-only and the two movie games stay locked.

# Global leaderboards (Supabase). Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The two movie games (scene clip + poster zoom).
# Free key: https://www.themoviedb.org/settings/api  — the "API Read Access Token" (v4) or the v3 key both work.
VITE_TMDB_KEY=
